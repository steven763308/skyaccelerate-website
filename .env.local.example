# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Resend (https://resend.com) — powers the contact form's email delivery.
# 1. Sign up at resend.com and create an API key.
# 2. Verify the skyaccelerate.com domain under Resend > Domains (adds a few DNS records)
#    so mail can be sent from your own domain instead of Resend's shared test domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Sky Accelerate Website <website@skyaccelerate.com>"

# SAG (Sky Accelerate Panel) — site content is loaded from SAG (Marketing →
# Website Content) and contact-form submissions are saved into SAG as CRM
# leads. SAG also uses WEBSITE_API_KEY to call /api/revalidate on publish. SAG_API_URL is the SAG backend's base URL (no trailing
# /api). WEBSITE_API_KEY must exactly match WEBSITE_API_KEY on the SAG backend
# (Render). If both these and RESEND_API_KEY are set, the enquiry goes to both;
# the form succeeds as long as either one gets it.
SAG_API_URL=
WEBSITE_API_KEY=
